Java
import java.util.ArrayList;

public class Sistema {
    private ArrayList<Veiculo> veiculos = new ArrayList<>();
    private ArrayList<Motorista> motoristas = new ArrayList<>();
    private ArrayList<Entrega> entregas = new ArrayList<>();

    // 1. Associar motorista a veículo
    public void associar(Motorista m, Veiculo v) {
        m.setVeiculo(v);
        v.setMotorista(m);
    }

    // 2. Atribuir entrega a veículo
    public void atribuirEntrega(Entrega e, Veiculo v) {
        if (!e.getStatus().equals("pendente")) {
            v.adicionarEntrega(e);
            e.setVeiculo(v);
        }
    }

    // 3. Listar entregas de um veículo
    public void listarEntregas(Veiculo v) {
        int total = 0;
        for (Entrega e : v.getEntregas()) {
            System.out.println(e);
            total++;
        }
        System.out.println("Total: " + total);
    }

    // 4. Total finalizadas por veículo
    public void totalFinalizadas(Veiculo v) {
        int total = 0;
        for (Entrega e : v.getEntregas()) {
            if (e.getStatus().equals("finalizada")) {
                total++;
            }
        }
        System.out.println("Finalizadas: " + total);
    }

    // 5. Buscar por status
    public void buscarPorStatus(String status) {
        for (Entrega e : entregas) {
            if (e.getStatus().equals(status)) {
                System.out.println(e);
            }
        }
    }
}
